FROM oven/bun:1.2.18 AS build
WORKDIR /usr/src/app
RUN apt-get update && apt-get install -y libexpat1
RUN apt-get install -y \
  wkhtmltopdf \
  fontconfig \
  fonts-dejavu \
  && rm -rf /var/lib/apt/lists/*

COPY package.json bun.lock ./

COPY shared ./shared
COPY alerts ./alerts
RUN mkdir server notification indexer client
RUN bun install

WORKDIR /usr/src/app/alerts
RUN bun run build

FROM oven/bun:1.2.18 AS release
WORKDIR /usr/src/app
RUN apt-get update && apt-get install -y \
  fontconfig \
  fonts-dejavu-core \
  && rm -rf /var/lib/apt/lists/*

# copy wkhtmltopdf binary only
COPY --from=build /usr/bin/wkhtmltopdf /usr/bin/wkhtmltopdf

ENV NODE_ENV=production

COPY --from=build /usr/src/app/node_modules ./node_modules

COPY --from=build /usr/src/app/alerts/dist ./alerts/dist

COPY --from=build /usr/src/app/shared ./shared

WORKDIR /usr/src/app/alerts

EXPOSE 3002
CMD ["bun", "dist/src/server.js"]
